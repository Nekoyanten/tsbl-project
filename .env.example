# TSBL — Variables de Entorno
# Copiar a .env y completar valores

# Servidor
TSBL_HOST=0.0.0.0
TSBL_PORT=8000
TSBL_ENV=development

# WebSocket
WS_HEARTBEAT_INTERVAL=30
WS_MAX_MESSAGE_SIZE=1048576

# Modelos (rutas relativas al proyecto)
VJEPA_WEIGHTS_PATH=data/models/vjepa2_vitl16.pth
PREDICTOR_WEIGHTS_PATH=data/models/predictor_jc_8layer.pth

# Base de datos
DATABASE_URL=sqlite:///data/tsbl_dev.db

# RLM (API externa — solo para análisis post-sesión)
RLM_API_KEY=sk-your-key-here
RLM_MODEL=gpt-4o-mini

# Seguridad (generar con openssl rand -hex 32)
SECRET_KEY=change-me-in-production
HASH_SALT=change-me-in-production
